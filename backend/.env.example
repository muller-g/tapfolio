# =============================================================================
# TapFolio — Backend (Laravel 11)
# Copie para backend/.env e preencha os valores reais
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=TapFolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# Os aliases POSTGRES_* são lidos pelo container postgres no docker-compose
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tapfolio
DB_USERNAME=tapfolio
DB_PASSWORD=secret

POSTGRES_DB=tapfolio
POSTGRES_USER=tapfolio
POSTGRES_PASSWORD=secret

# -----------------------------------------------------------------------------
# Cache, Filas e Sessão (Redis)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Autenticação (Laravel Sanctum)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# -----------------------------------------------------------------------------
# Email (SMTP)
# Mailpit em dev: http://localhost:8025
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tapfolio.app
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Armazenamento de Arquivos (MinIO / S3-compatible)
# Console MinIO em dev: http://localhost:9001
# Os aliases MINIO_* são lidos pelo container minio no docker-compose
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tapfolio
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
STORAGE_PUBLIC_URL=http://localhost:9000/tapfolio

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Monitoramento (Sentry)
# -----------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Limites de Negócio
# -----------------------------------------------------------------------------
MAX_LINKS_PER_PROFILE=20
MAX_AVATAR_SIZE_KB=2048
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
