# =============================================================================
# TapFolio — Frontend (Next.js 14)
# Copie para frontend/.env.local e preencha os valores reais
# Variáveis prefixadas com NEXT_PUBLIC_ são expostas ao browser
# =============================================================================

# URL da API Laravel (usada em Server Components e pelo browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# URL pública do frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoramento (Sentry)
NEXT_PUBLIC_SENTRY_DSN=
