# =============================================================================
# TapFolio — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env com valores reais
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=TapFolio
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tapfolio
DB_USERNAME=tapfolio
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# Redis (Cache + Filas)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie

# -----------------------------------------------------------------------------
# Autenticação JWT (Sanctum)
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000
JWT_SECRET=gere-um-valor-seguro-com-32-chars-minimo

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tapfolio.app
MAIL_FROM_NAME="TapFolio"

# -----------------------------------------------------------------------------
# Armazenamento de Arquivos (MinIO / S3)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tapfolio
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# URL pública para acessar arquivos (avatar, etc.)
STORAGE_PUBLIC_URL=http://localhost:9000/tapfolio

# -----------------------------------------------------------------------------
# Monitoramento (Sentry)
# -----------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Limites e Configurações de Negócio
# -----------------------------------------------------------------------------
MAX_LINKS_PER_PROFILE=20
MAX_AVATAR_SIZE_KB=2048
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# -----------------------------------------------------------------------------
# Frontend (Next.js) — prefixo NEXT_PUBLIC_ expõe ao browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
